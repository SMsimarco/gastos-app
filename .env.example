NEXT_PUBLIC_SUPABASE_URL=https://tuproyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Web Push (avisos al usuario). Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT_EMAIL=

# Cron jobs (Vercel Cron manda este secreto en el header Authorization)
CRON_SECRET=

# Telegram Bot API (guardar como secretos; nunca exponer con NEXT_PUBLIC_)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Twelve Data — cierres diarios de la cartera (https://twelvedata.com)
TWELVE_DATA_API_KEY=

# Gmail — auto-registro de gastos por email (opcional, ver README > Puesta en marcha > 5)
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=

# Laboratorio (SIMULADO) — recolección de datos de mercado, ver NOTES.md > Fase 6A
# Alpaca: market data (feed IEX gratis) y reloj del mercado. Cuenta paper en https://alpaca.markets
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# FRED (macro): key gratis en https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Finnhub (calendario de balances): key gratis en https://finnhub.io
FINNHUB_API_KEY=
# Secreto de los endpoints /api/lab/* (lo manda pg_cron en Authorization: Bearer ...). Generar con: openssl rand -hex 32
LAB_CRON_SECRET=
